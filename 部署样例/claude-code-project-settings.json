{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON>",
            "args": [
              "-X",
              "utf8",
              "-B",
              "<BIN>/handoff_gate.py",
              "--hook"
            ],
            "timeout": 20,
            "statusMessage": "交接报告写后检查"
          }
        ]
      }
    ]
  }
}
